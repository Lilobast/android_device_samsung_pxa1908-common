ro.telephony.ril.config=simactivation

hwc.overlay.enable=0
hwc.virtual.gcu.enable=0

# Vivante EGL always reports EGL_BUFFER_AGE_EXT = 1 (real age is 3 with triple
# buffering) -> HWUI partial redraws left stale areas (flickering toolbars).
# Patched HWUI takes the age from the window's BufferQueue instead.
debug.hwui.window_buffer_age=true

debug.falsing_log=true
debug.falsing_logcat=true

# Stock camera HAL hands video frames to the encoder as raw fds (L style):
# run OMX in mediaserver, next to the camera, so the fds stay valid.
media.stagefright.codecremote=false

# Radio (values from stock G361F build.prop)
# run_composite.sh enables the Samsung IPC channels (ssipc_misc ssipc_ch_enable) before the CP boots
# only when this is true; without it umts_ipc0/umts_rfs0 never receive anything (RADIO_UNAVAILABLE).
ro.cmd.ssipc_enable=true
persist.radio.rem.enable=0
ril.stk.sim.profile=FFFFFFFF7F0F009F7F00001FE200000003
ril.stk.usim.profile=FFFFFFFF7F9F00DFFF00001FE2000000C3E00000000148005100000000080000
