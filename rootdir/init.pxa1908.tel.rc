import /init.tel.rc

on init
    # set CP master or slave
    setprop persist.radio.pcmmaster 0

on fs
# mount emmc partitions
    # for e2fsck bad block of /NVM partition before mount
    exec /system/bin/e2fsck -vy /dev/block/platform/soc.2/by-name/NVM

service marvelltel /system/bin/tel_launch.sh
    class main
    oneshot
    group system

service at_distributor /system/bin/at_distributor
    class late_start
    user root
    group radio misc log

# Pie runs the GNSS HAL as gps (its socket /data/gps/s_gnss is gps 0700); as system the LPM
# server got EACCES and the HAL retried every 2 s (log spam, wakeups). The system group keeps
# access to /data/gps (system 0771).
service gpslpm_srv /system/bin/gpslpm_srv
    class main
    user gps
    group gps system

# LPM
service marvelltel_lpm /system/bin/tel_lpm.sh
    class sec_charger
    oneshot

service ril-daemon2 /vendor/bin/hw/rild -l /system/lib/libsec-ril-dsds.so -c 2
    class main
    socket rild2 stream 660 root radio
    socket rild-debug2 stream 660 radio system
    user root
    group radio cache inet misc audio sdcard_r sdcard_rw log system
    disabled

