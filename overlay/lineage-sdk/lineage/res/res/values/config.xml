<?xml version="1.0" encoding="utf-8"?>
<!--
     PXA1908: LiveDisplay colour calibration is applied by the HW composer
     (cmhw DisplayColorCalibration -> sys.livedisplay.rgb -> hwcomposer.mrvl),
     so the tint no longer forces GPU composition. Use the usual default.
-->
<resources>
    <!-- 0 = off, 1 = night, 2 = auto, 3 = outdoor, 4 = day -->
    <integer name="config_defaultLiveDisplayMode">2</integer>

    <!-- Physical home key, capacitive back and recents (sec_touchscreen.kl):
         HOME 1 + BACK 2 + APP_SWITCH 16 -->
    <integer name="config_deviceHardwareKeys">19</integer>

    <!-- Home wakes the screen like on stock; volume wake stays a user option.
         HOME 1 + VOLUME 64 -->
    <integer name="config_deviceHardwareWakeKeys">65</integer>
</resources>
