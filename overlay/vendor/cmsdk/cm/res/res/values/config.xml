<?xml version="1.0" encoding="utf-8"?>
<!--
     PXA1908: LiveDisplay colour calibration is applied by the HW composer
     (cmhw DisplayColorCalibration -> sys.livedisplay.rgb -> hwcomposer.mrvl),
     so the tint no longer forces GPU composition. Use the usual default.
-->
<resources>
    <!-- 0 = off, 1 = night, 2 = auto, 3 = outdoor, 4 = day -->
    <integer name="config_defaultLiveDisplayMode">2</integer>
</resources>
